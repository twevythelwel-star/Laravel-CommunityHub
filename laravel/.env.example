APP_NAME="Community Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Jamaica
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────
# Use sqlite for a zero-setup local run: set DB_CONNECTION=sqlite and
# touch database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Digital Gate Pass Engine ─────────────────────────────────────────
# REQUIRED. Generate with: php artisan gatepass:secret
# This replaces GATE_ENGINE_SECRET, which was hardcoded in client-side
# JavaScript and therefore readable by anyone who opened the app.
# Never commit a real value.
GATE_ENGINE_SECRET=
GATE_COMMUNITY_ID=CID-CYPRESS-BAY
GATE_WINDOW_SECONDS=30

# ── AI (optional) ────────────────────────────────────────────────────
# Without a key, notification targeting falls back to the same
# deterministic output the original stub produced.
# Stripe. Leave blank and the checkout routes 404 rather than simulating
# a payment. Must begin with sk_ to be treated as live.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Public, unauthenticated payment links. Off until a driver settles funds.
PAYMENT_PUBLIC_LINKS_ENABLED=false

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# ── Seeding ──────────────────────────────────────────────────────────
# Password given to every seeded demo account. Change before any real use.
SEED_PASSWORD=ChangeMe!2026

VITE_APP_NAME="${APP_NAME}"
