# Production settings for docker-compose.yml.
#
#   cp .env.production.example .env.production
#
# .env.production is gitignored. Never commit a filled-in copy.
# Every value marked REQUIRED must be set before the first start.

APP_NAME="Community Hub"
APP_ENV=production
# REQUIRED. Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Jamaica
# REQUIRED. The public https:// address residents use.
APP_URL=https://hub.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Containers log to stderr so `docker compose logs` shows everything.
# The `security` channel (refused scans, deactivations) still writes to
# storage/logs/security.log on the shared storage volume.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Behind a TLS-terminating proxy, set its address (or * if only the proxy
# can reach the container). See config/trustedproxy.php.
TRUSTED_PROXIES=

# ── Database ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=community_hub
DB_USERNAME=community_hub
# REQUIRED. Also used by the db container to create the account.
DB_PASSWORD=
# REQUIRED. Only the db container uses this.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# The queue container in docker-compose.yml works this queue.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────
# Visitor-pass emails are queued notifications. With the default `log`
# mailer they are written to the log and never sent.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Digital Gate Pass Engine ─────────────────────────────────────────
# REQUIRED. Generate a fresh value per environment with:
#   php artisan gatepass:secret --show
# Never reuse the development value.
GATE_ENGINE_SECRET=
GATE_COMMUNITY_ID=CID-CYPRESS-BAY
GATE_WINDOW_SECONDS=30

# ── Payments ─────────────────────────────────────────────────────────
# Leave blank and the checkout routes 404 rather than simulate a payment.
# Set both together: the webhook at https://<host>/api/webhooks/stripe is what
# settles an invoice when the resident closes the tab before the redirect.
# See "Stripe Checkout" in README.md for the events to subscribe to.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PUBLIC_LINKS_ENABLED=false

# ── Optional integrations ────────────────────────────────────────────
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# SMS and WhatsApp visitor passes, through Twilio. Leave blank and both
# options are disabled in the UI. WhatsApp outside the sandbox needs an
# approved template: set TWILIO_WHATSAPP_CONTENT_SID (see WhatsAppService).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
SMS_DEFAULT_COUNTRY_CODE=1
