{
    "name": "triovo/community-hub",
    "type": "project",
    "description": "Community Hub \u2014 gated-community management platform (Laravel + Inertia + React).",
    "keywords": [
        "laravel",
        "inertia",
        "community",
        "gate-pass"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^2.0.8",
        "barryvdh/laravel-dompdf": "*",
        "inertiajs/inertia-laravel": "^1.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "livewire/livewire": "^4.4",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "stripe/stripe-php": "*",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.0",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@composer validate --no-check-publish --no-check-all",
            "@php artisan test",
            "@php vendor/bin/pint --test",
            "npm run typecheck",
            "npm audit --omit=dev --audit-level=high",
            "npm run build"
        ]
    },
    "scripts-descriptions": {
        "check": "Every build gate CI runs: lock file, tests, Pint, TypeScript, npm audit and the production build."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
